# sqlx checksums every migration byte for byte and stores the checksum in the database. With core.autocrlf a
# checkout could turn LF into CRLF, change the checksum and stop the app at start-up, so SQL is always LF.
*.sql text eol=lf
crates/db/migrations/*.sql text eol=lf
# Command-line launchers shipped in <install>\bin: batch files need CRLF, the Git Bash script LF.
src-tauri/cli/*.cmd text eol=crlf
src-tauri/cli/openmind text eol=lf

# Signed test fixtures: the signatures cover these exact bytes, so line endings must never be converted.
src-tauri/src/updates/fixtures/* -text
