# sqlx checksums every migration byte for byte and stores the checksum in the database. With core.autocrlf a
# checkout could turn LF into CRLF, change the checksum and stop the app at start-up, so SQL is always LF.
*.sql text eol=lf
crates/db/migrations/*.sql text eol=lf
# Command-line launchers shipped in <install>\bin: batch files need CRLF, the Git Bash script LF.
src-tauri/cli/*.cmd text eol=crlf
src-tauri/cli/openmind text eol=lf
# The deployment package shipped in <install>\deploy (launchers, logon script): batch files need CRLF.
src-tauri/deploy/*.cmd text eol=crlf
src-tauri/deploy/*.txt text eol=crlf
# Shell scripts run in WSL and Linux containers straight from this checkout: LF, or bash stops at the first CR.
*.sh text eol=lf

# Launchers shipped with the portable packages: the batch file needs CRLF, the macOS/Linux scripts LF.
scripts/launchers/**/*.bat text eol=crlf
scripts/launchers/**/*.command text eol=lf
scripts/launchers/**/*.sh text eol=lf

# Signed test fixtures: the signatures cover these exact bytes, so line endings must never be converted.
src-tauri/src/updates/fixtures/* -text
# Release build scripts: the batch file needs CRLF, the macOS script LF.
scripts/*.bat text eol=crlf
scripts/*.command text eol=lf
