# Rust
/target/
src-tauri/target/
src-tauri/gen/
Cargo.lock.bak

# Machine-local cargo override (e.g. redirecting target-dir off a full drive)
/.cargo/config.toml

# Node
node_modules/
dist/
public/monaco-workers/
public/pdf/
dist-ssr/
.vite/
*.tsbuildinfo

# App data (portable SQLite store, never committed)
/data/
*.db
*.db-shm
*.db-wal

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
Thumbs.db
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env
.env
.env.local

# Claude Code session lock (per machine, changes while a session runs)
.claude/scheduled_tasks.lock

# Developer-populated tool bundle copied into the portable package (see docs/toolchains.md)
/tools-bundle/
# The offline language server bundle (pnpm lsp:bundle); only its README is committed
/lsp-bundle/*
!/lsp-bundle/README.txt
/.lsp-bundle-cache/
/release/
/python-bundle/*
!/python-bundle/README.txt
/.python-bundle-cache/
