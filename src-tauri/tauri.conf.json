{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMind Studio",
  "version": "1.0.3",
  "identifier": "com.openmindstudio.app",
  "mainBinaryName": "OpenMindStudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenMind Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "OpenMind",
    "copyright": "Copyright © 2026 OpenMind",
    "shortDescription": "OpenMind Studio — a portable, native code editor",
    "longDescription": "OpenMind Studio is a portable, native desktop code editor and part of the OpenMind ecosystem (OpenMind AI, OpenMind Runtime, OpenMind Extensions). It runs entirely from its own directory with no admin rights and no dependency on globally installed software.",
    "windows": {
      "allowDowngrades": false,
      "signCommand": {
        "cmd": "node",
        "args": ["../scripts/sign-file.mjs", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US",
        "fragmentPaths": ["wix/product-icon.wxs", "wix/integration.wxs"],
        "componentRefs": ["OmCliPath", "OmExplorerMenu", "OmInstallLayout"],
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../lsp-bundle/": "lsp/",
      "../python-bundle/": "python-bundle/",
      "cli/openmind.cmd": "bin/openmind.cmd",
      "cli/openmind": "bin/openmind"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNTkwQzRFNzE0MkYyQ0YKUldUUDhrSnhUZ3haZXNDZ09MU2dHVGlwTTI5U2dyZEFNSFdKUnpaKyt0Z1ZTZWVOampCZFhpOXQK",
      "endpoints": [
        "https://github.com/smshagor-dev/OpenMind-Studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
