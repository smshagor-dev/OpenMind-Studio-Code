{
  "name": "sample-ai-mock",
  "displayName": "Sample AI Mock Endpoint",
  "description": "An AI provider pointed at a mock server on 127.0.0.1:18080 (for manual verification).",
  "version": "1.0.0",
  "publisher": "openmind-samples",
  "engines": { "vscode": "^1.85.0" },
  "contributes": {
    "aiProviders": [
      {
        "id": "mock",
        "name": "Mock AI (127.0.0.1:18080)",
        "type": "openai-compatible",
        "capabilities": ["chat", "streaming"],
        "defaultModel": "mock-model",
        "models": ["mock-model"],
        "baseUrl": "http://127.0.0.1:18080/v1"
      }
    ]
  }
}
