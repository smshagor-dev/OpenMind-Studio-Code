{
  "id": "go",
  "displayName": "Go",
  "description": "Go compiler and tools (go, gofmt).",
  "defaultVersion": "1.27.1",
  "versionCommand": {
    "executable": "bin/go.exe",
    "args": [
      "version"
    ],
    "outputPrefix": "go version go"
  },
  "binDirs": [
    "bin"
  ],
  "verifyFiles": [
    "bin/go.exe",
    "bin/gofmt.exe"
  ],
  "env": {
    "GOPATH": "{cache}\\go",
    "GOTOOLCHAIN": "local"
  },
  "requires": [],
  "license": {
    "name": "BSD-3-Clause",
    "url": "https://go.dev/LICENSE",
    "acceptanceRequired": false
  },
  "probeSystem": true,
  "notes": "Official go.dev Windows ZIP; SHA256 published on go.dev/dl. GOPATH (modules, gopls) is in the app's cache folder; GOTOOLCHAIN=local so Go never downloads another toolchain by itself. Go keeps local-only telemetry counters in %APPDATA%\\go\\telemetry (Go's default; nothing is uploaded unless you run `go telemetry on`); an environment variable can't turn that off — run `go telemetry off` if you want.",
