{
  "id": "llvm-mingw",
  "displayName": "C/C++ toolchain (LLVM-MinGW)",
  "description": "Clang, LLD, LLDB and the MinGW-w64 runtime: a C/C++ compiler that needs no Visual Studio.",
  "defaultVersion": "20260922",
  "versionCommand": {
