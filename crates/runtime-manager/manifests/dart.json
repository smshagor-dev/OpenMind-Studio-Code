{
  "id": "dart",
  "displayName": "Dart SDK",
  "description": "Dart compiler, package manager (pub) and analysis server.",
  "defaultVersion": "3.13.4",
  "versionCommand": {
    "executable": "bin/dart.exe",
    "args": [
      "--version"
    ],
    "outputPrefix": "Dart SDK version: "
  },
  "binDirs": [
    "bin"
  ],
  "verifyFiles": [
    "bin/dart.exe"
  ],
  "env": {
    "PUB_CACHE": "{cache}\\pub",
    "DART_SUPPRESS_ANALYTICS": "true"
  },
  "requires": [],
  "license": {
    "name": "BSD-3-Clause",
    "url": "https://dart.dev/",
    "acceptanceRequired": false
  },
  "probeSystem": false,
