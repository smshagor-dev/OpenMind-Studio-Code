    {
      "version": "3.13.4",
      "artifacts": [
        {
          "platform": "windows-x64",
          "url": "https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.4/sdk/dartsdk-windows-x64-release.zip",
          "sha256": "c38bcecee16b348694d4acc72b3781e5fa0e8766a4d0d1576182c7204ab3d763",
          "sizeBytes": 219873408,
          "installBytes": 616268993,
          "archive": "zip",
          "stripComponents": 1
        }
      ]
    }
  ]
